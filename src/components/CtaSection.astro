---
import { siteConfig } from "../config";
import { useTranslations, type Lang } from "../i18n/utils";
import SectionHeading from "./SectionHeading.astro";
import Button from "./Button.astro";

/**
 * Closing call-to-action (§6.9), inviting visitors to reach out for questions
 * and exchange about the project.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="cta">
  <div class="inner">
    <SectionHeading
      size="cta"
      lines={[{ text: t("cta.h2a") }, { text: t("cta.h2b"), outline: true }]}
    />
    <div class="sub">
      <p>{t("cta.sub")}</p>
      <p>{t("cta.ask")}</p>
    </div>
    <Button
      href={siteConfig.links.aiMods}
      variant="accent-filled"
      external
      arrow
    >
      ai-mods.de
    </Button>
    <div class="tagline">{t("cta.tagline")}</div>
  </div>
</section>

<style>
  .cta {
    padding-inline: var(--pad-x);
    text-align: center;
  }

  .inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding-block: 100px;
  }

  .cta :global(.heading) {
    margin-bottom: 24px;
  }

  /* Wider measure than the other subs (460px) plus a balanced rag: at 460px the
     centred text read as a narrow column with an orphan word on the last line.
     Browsers without `balance` fall back to a plain rag. */
  .sub {
    margin: 0 auto 32px;
    max-width: 700px;
    text-wrap: balance;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .sub p {
    margin: 0 0 16px;
  }

  .sub p:last-child {
    margin-bottom: 0;
  }

  .tagline {
    margin-top: 20px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-ghost);
  }
</style>
